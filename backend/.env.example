# ibom_ai_agent_stack backend environment
# Copy this file to backend/.env and fill in real secrets locally.
# Do not commit backend/.env.

# ============================================================
# Application
# ============================================================
PROJECT_NAME=ibom_ai_agent_stack
ENVIRONMENT=local
DEBUG=true
DB_ECHO=false  # Set to true to log SQL queries
TIMEZONE=Europe/London  # IANA timezone: UTC, Europe/London, America/New_York
MODELS_CACHE_DIR=./models_cache
FRONTEND_URL=https://localhost:3000

# ============================================================
# Observability
# ============================================================
# Get a Logfire token from https://logfire.pydantic.dev.
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=ibom_ai_agent_stack
LOGFIRE_ENVIRONMENT=development

# ============================================================
# Database - Supabase Postgres
# ============================================================
# This stack uses Supabase Postgres as the single source of truth.
# pgvector must be enabled in this database for RAG embeddings.
# Use direct connection when reachable, or shared pooler session mode on port 5432.
# Avoid transaction pooling on port 6543 unless the app is changed for it.
POSTGRES_HOST=aws-1-eu-west-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=<supabase-database-password>
POSTGRES_DB=postgres
POSTGRES_SSLMODE=require
POSTGRES_ASYNCPG_SSL=require

# ============================================================
# Backend JWT and API Key Auth
# ============================================================
# Generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# ============================================================
# Supabase OTP Auth
# ============================================================
# Used for Supabase one-time-password sign-in from the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-public-key>

# ============================================================
# Google OAuth Auth
# ============================================================
# Redirect URI must exactly match the Google Cloud OAuth allow list.
# Local HTTPS development: https://localhost:3000/auth/callback
# Local Supabase email/OTP redirect: https://localhost:3000/login
# Raw HTTP fallback when bypassing the local HTTPS proxy: http://localhost:3001/auth/callback
# Production: https://advancedanalytica.co.uk/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://localhost:3000/auth/callback

# ============================================================
# Redis, Celery, and Flower
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-in-production

# ============================================================
# Storage - S3 or MinIO
# ============================================================
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ibom_ai_agent_stack
S3_REGION=us-east-1

# ============================================================
# AI Provider API Keys
# ============================================================
# Chat and embeddings are configured independently below.
# Fill only the provider keys you enable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ============================================================
# Chat Model Configuration
# ============================================================
# CHAT_PROVIDER is the default provider.
# CHAT_MODEL is the default model for that provider.
# CHAT_ENABLED_PROVIDERS controls which providers appear in the frontend picker.
# Valid providers: anthropic, openai, gemini.
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-5.4-mini
CHAT_ENABLED_PROVIDERS=["openai"]
CHAT_ANTHROPIC_MODELS=["claude-sonnet-4-5","claude-opus-4-1","claude-haiku-4-5"]
CHAT_OPENAI_MODELS=["gpt-5.4-mini","gpt-5.4","gpt-4.1-mini"]
CHAT_GEMINI_MODELS=["gemini-2.5-flash","gemini-2.5-pro","gemini-2.0-flash"]

# Legacy chat aliases retained for older clients.
# Keep these aligned with CHAT_PROVIDER and CHAT_MODEL until legacy clients are removed.
LLM_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_TEMPERATURE=0.7
AI_THINKING_ENABLED=false
AI_THINKING_EFFORT=medium  # low, medium, high

# ============================================================
# Embeddings and RAG
# ============================================================
# EMBEDDING_PROVIDER is independent of CHAT_PROVIDER.
# Valid embedding providers: openai, gemini.
# OpenAI dimensions: text-embedding-3-small=1536, text-embedding-3-large=3072, text-embedding-ada-002=1536.
# Gemini dimensions: gemini-embedding-exp-03-07=3072.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_CHUNKING_STRATEGY=recursive  # recursive, markdown, or fixed
RAG_HYBRID_SEARCH=false  # Enable BM25 + vector hybrid search
RAG_ENABLE_OCR=false  # OCR fallback for scanned PDFs; requires tesseract-ocr

# ============================================================
# Deep Research and Web Search
# ============================================================
# Tavily is used for web search when enabled by the app.
# Deep research settings are separate from chat provider/model selection.
TAVILY_API_KEY=
ENABLE_DEEP_RESEARCH=true
DEEP_RESEARCH_MAX_TOKENS=120000
DEEP_RESEARCH_COMPRESS_THRESHOLD=0.8

# ============================================================
# CORS
# ============================================================
# JSON list of allowed origins. In production, use explicit origins instead of "*".
CORS_ORIGINS=["https://localhost:3000","http://localhost:3001","http://localhost:3000","http://localhost:8080"]

# ============================================================
# Production Deployment - Traefik
# ============================================================
DOMAIN=example.com
ACME_EMAIL=admin@example.com
# Generate with: htpasswd -nb admin password
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
